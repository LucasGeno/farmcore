# FarmCore configuration. Copy to `.env`; never commit `.env`.
# Empty values mean "use the default" (src/farmcore/settings.py).
# One env file per installation: several installations on one host each get their own copy,
# e.g. `docker compose -p farm-a --env-file farm-a.env up -d` (docs/self-hosting.md).

# --- Required by docker-compose.yml -------------------------------------------------------
# Owner/migrator role (`farmcore`): only the `migrate` and `backup` services get it.
# openssl rand -hex 32 (hex: the value goes into a database URL)
POSTGRES_PASSWORD=
# DML-only runtime role (`farmcore_app`) the app and bot connect as; `migrate` creates it and
# resets its password to this value on every run. openssl rand -hex 32
RUNTIME_DATABASE_PASSWORD=
# Administrator token, at least 32 characters: openssl rand -hex 24
# Without it, operator actions fail closed. Farm reads require a member session or token.
ADMIN_TOKEN=

# --- Compose project ---------------------------------------------------------------------
# Project name: prefixes containers, network, volumes and the image tag. Default: the name of
# the directory holding docker-compose.yml. `docker compose -p NAME` overrides it.
COMPOSE_PROJECT_NAME=
# Run a released image instead of building one (default: farmcore-<project>:local, built here).
# Build and tag it once (docker build -t farmcore:0.2.0 .); never `up --build` with this set.
FARMCORE_IMAGE=
# The owner's age public key (age1...; `age-keygen -y farmcore-backup.key`). Daily backups are
# encrypted to it; keep the private key off the server. Without it no backup is written.
BACKUP_RECIPIENT=
# Host directory for the daily bundles (one per installation, writable by uid 10001).
# Default: the `backups` volume.
BACKUP_DIR=

# --- Web --------------------------------------------------------------------------------
# Public URL of this installation (links in bot messages and exports).
PUBLIC_BASE_URL=http://localhost:8000
# Compose only: host address and port the app is published on (keep 127.0.0.1 behind a proxy).
FARMCORE_BIND=127.0.0.1
FARMCORE_PORT=8000
# Address of your reverse proxy, so uvicorn trusts its X-Forwarded-* headers.
FORWARDED_ALLOW_IPS=
# Set to 1 on any network-reachable install (docker-compose.yml always sets it): refuse to
# start without a strong ADMIN_TOKEN and turn off the interactive API docs.
FARMCORE_PUBLIC=

# --- Local development (uv run ...) --------------------------------------------------------
# Default: postgresql+psycopg://farmcore:farmcore@localhost:55442/farmcore (docker-compose.dev.yml)
DATABASE_URL=
# `farmcore migrate` only: runtime role to create (default farmcore_app) and its password.
# Without a password no runtime role is provisioned and everything uses DATABASE_URL.
RUNTIME_DATABASE_ROLE=
# Admin URL for throwaway test databases. Default: DATABASE_URL's server, database `postgres`.
TEST_DATABASE_URL=
# Raw files read by `farmcore seed` and the importers. Default: sample-data
DATA_DIR=
DISPLAY_TZ=
# replay (default: a shared clock replays a past season) | live
CLOCK_MODE=
REPLAY_START=
DEFAULT_FARM_KEY=
# Compose only: amd64 default postgis/postgis:17-3.5; on arm64 use imresamu/postgis:17-3.5
POSTGIS_IMAGE=

# --- Telegram bot (optional) -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Public bot @username without "@": the web "Log a spray" button opens t.me/<username>.
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram user ids allowed to use the bot; empty = nobody.
TELEGRAM_ALLOWED_USER_IDS=
# Local speech-to-text model (faster-whisper).
WHISPER_MODEL=

# --- Gemini on Vertex AI (optional) --------------------------------------------------------
# regex (local parser, no cloud call) | vertex (Gemini, falls back to regex) | fake (tests)
EXTRACTOR=regex
VERTEX_PROJECT=
VERTEX_LOCATION=europe-west4
VERTEX_MODEL=
# adc (GOOGLE_APPLICATION_CREDENTIALS key file) | gcloud (local CLI login) | token
VERTEX_AUTH=
# Optional; default {location}-aiplatform.googleapis.com
VERTEX_HOST=
VERTEX_ACCESS_TOKEN=
# Compose only (docker-compose.vertex.yml): path of the service-account key file.
VERTEX_CREDENTIALS_FILE=

# Optional public showcase: explicitly designate only intentionally public farm IDs.
DEMO_MODE=false
DEMO_FARM_IDS=[]
