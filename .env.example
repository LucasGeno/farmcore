# FarmCore configuration. Copy to `.env`; never commit `.env`.
# Empty values mean "use the default" (src/farmcore/settings.py).
# One env file per installation: several installations on one host each get their own copy,
# e.g. `docker compose -p farm-a --env-file farm-a.env up -d` (docs/self-hosting.md).

# --- Required by docker-compose.yml -------------------------------------------------------
# Owner/migrator role (`farmcore`): only the `migrate` and `backup` services get it.
# openssl rand -hex 32 (hex: the value goes into a database URL)
POSTGRES_PASSWORD=
# DML-only runtime role (`farmcore_app`) the app and bot connect as; `migrate` creates it and
# resets its password to this value on every run. openssl rand -hex 32
RUNTIME_DATABASE_PASSWORD=
# Administrator token, at least 32 characters: openssl rand -hex 24
# Without it, operator actions fail closed. Farm reads require a member session or token.
ADMIN_TOKEN=

# --- Compose project ---------------------------------------------------------------------
# Project name: prefixes containers, network, volumes and the image tag. Default: the name of
# the directory holding docker-compose.yml. `docker compose -p NAME` overrides it.
COMPOSE_PROJECT_NAME=
# Run a released image instead of building one (default: farmcore-<project>:local, built here).
# Build and tag it once (docker build -t farmcore:0.2.0 .); never `up --build` with this set.
FARMCORE_IMAGE=
# The owner's age public key (age1...; `age-keygen -y farmcore-backup.key`). Daily backups are
# encrypted to it; keep the private key off the server. Without it no backup is written.
# Only age1 keys; separate several with spaces. It lets anyone encrypt a bundle, not read one.
BACKUP_RECIPIENT=
# Host directory for the daily bundles (one per installation, writable by uid 10001).
# Default: the `backups` volume.
BACKUP_DIR=

# --- Web --------------------------------------------------------------------------------
# Public URL of this installation (links in bot messages and exports).
PUBLIC_BASE_URL=http://localhost:8000
# Compose only: host address and port the app is published on (keep 127.0.0.1 behind a proxy).
FARMCORE_BIND=127.0.0.1
FARMCORE_PORT=8000
# Address of your reverse proxy, so uvicorn trusts its X-Forwarded-* headers.
FORWARDED_ALLOW_IPS=
# Set to 1 on any network-reachable install (docker-compose.yml always sets it): refuse to
# start without a strong ADMIN_TOKEN and turn off the interactive API docs.
FARMCORE_PUBLIC=

# --- Local development (uv run ...) --------------------------------------------------------
# Default: postgresql+psycopg://farmcore:farmcore@localhost:55442/farmcore (docker-compose.dev.yml)
DATABASE_URL=
# `farmcore migrate` only: runtime role to create (default farmcore_app) and its password.
# Without a password no runtime role is provisioned and everything uses DATABASE_URL.
RUNTIME_DATABASE_ROLE=
# Admin URL for throwaway test databases. Default: DATABASE_URL's server, database `postgres`.
TEST_DATABASE_URL=
# Raw files read by `farmcore seed` and the importers. Default: sample-data
DATA_DIR=
DISPLAY_TZ=
# replay (default: a shared clock replays a past season) | live
CLOCK_MODE=
REPLAY_START=
DEFAULT_FARM_KEY=
# Compose only: amd64 default postgis/postgis:17-3.5; on arm64 use imresamu/postgis:17-3.5
POSTGIS_IMAGE=

# --- Open-Meteo weather (optional) ---------------------------------------------------------
# Base URL: scheme and host; /v1/forecast is appended. Empty: the free non-commercial public
# APIs. Customer API: https://customer-api.open-meteo.com (use the Single Runs hostname from
# your customer dashboard for OPEN_METEO_SINGLE_RUNS_BASE_URL). Self-hosted:
# http://openmeteo:8080 with `docker compose --profile openmeteo up -d` (docs/self-hosting.md).
OPEN_METEO_BASE_URL=
OPEN_METEO_SINGLE_RUNS_BASE_URL=
# Customer API key, sent as `apikey` only to customer hosts; never logged, stored in receipts
# or shown in the UI. A key requires https base URLs.
OPEN_METEO_API_KEY=
# Compose only (profile openmeteo): pinned upstream image and its local data cache.
OPEN_METEO_IMAGE=ghcr.io/open-meteo/open-meteo:1.8.0
OPEN_METEO_REMOTE_DATA_DIRECTORY=https://openmeteo.s3.amazonaws.com/data/
OPEN_METEO_CACHE_SIZE=8GB

# --- Météo-France live station observations (optional, app weather_meteofrance) ------------
# Application credentials from https://portail-api.meteofrance.fr (subscribe the application to
# DPObs and DPClim). Exchanged for a one-hour token; never logged, stored in receipts or shown in
# the UI. Empty: the live ingest stays off. Both URLs must be https when a secret is set.
METEOFRANCE_CLIENT_ID=
METEOFRANCE_CLIENT_SECRET=
# METEOFRANCE_API_BASE_URL=https://public-api.meteofrance.fr/public
# METEOFRANCE_TOKEN_URL=https://portail-api.meteofrance.fr/token

# --- ERA5 history through Copernicus (optional, app weather_era5) ---------------------------
# Free CDS account key (https://cds.climate.copernicus.eu, profile page). Sent only to the CDS as
# PRIVATE-TOKEN; never logged, stored in receipts or shown in the UI. Empty: the backfill stays
# off. The URL must be https when a key is set.
CDSAPI_KEY=
# CDSAPI_URL=https://cds.climate.copernicus.eu/api

# --- Telegram bot (optional) -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Public bot @username without "@": the web "Log a spray" button opens t.me/<username>.
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram user ids allowed to use the bot; empty = nobody.
TELEGRAM_ALLOWED_USER_IDS=
# Local speech-to-text model (faster-whisper).
WHISPER_MODEL=

# --- Web assistant model (optional) ----------------------------------------------------------
# vertex (default; needs the Vertex block below) | openai-compatible | none (keyword router)
# ASSISTANT_PROVIDER=openai-compatible
# Base URL with its version path; /chat/completions is appended. OpenAI, OpenRouter, Mistral,
# Ollama (http://localhost:11434/v1), vLLM. A key needs https, except to localhost.
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# --- MCP over HTTP for remote agents (optional): `farmcore mcp --http` ------------------------
# Off unless true. Loopback unless a host is set; beyond loopback, only behind a buffering
# TLS reverse proxy with header and body timeouts.
# MCP_HTTP_ENABLED=true
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8001
# JSON lists. Origins browsers may call from (empty: any Origin is refused); accepted Host
# headers (empty: loopback names; behind a proxy, its public host name).
# MCP_HTTP_ALLOWED_ORIGINS=[]
# MCP_HTTP_ALLOWED_HOSTS=["farm.example.org"]
# MCP_HTTP_RATE_PER_TOKEN=120
# MCP_HTTP_RATE_PER_IP=300
# Largest request body in bytes, and concurrent connections (503 beyond). Idle or half-sent
# connections are never timed out here: beyond loopback a buffering proxy with header and body
# timeouts is required.
# MCP_HTTP_MAX_BODY_BYTES=65536
# MCP_HTTP_MAX_CONNECTIONS=32
# Proxy addresses whose X-Forwarded-For the per-address limit trusts; empty: none.
# MCP_HTTP_FORWARDED_ALLOW_IPS=
# The URL agents use for /mcp (behind a proxy, its public https URL): OAuth tokens are bound
# to it. Empty: http://localhost:<MCP_HTTP_PORT>/mcp.
# MCP_HTTP_PUBLIC_URL=https://farm.example.org/mcp
# OAuth 2.1 so a farm owner approves an agent (PUBLIC_BASE_URL is the issuer; both https).
# Clients until client registration exists: a JSON list.
# MCP_OAUTH_ENABLED=true
# MCP_OAUTH_CLIENTS=[{"client_id": "my-agent", "client_name": "My agent", "redirect_uris": ["https://agent.example/callback"]}]

# --- Gemini on Vertex AI (optional) --------------------------------------------------------
# regex (local parser, no cloud call) | vertex (Gemini, falls back to regex) | fake (tests)
EXTRACTOR=regex
VERTEX_PROJECT=
VERTEX_LOCATION=europe-west4
VERTEX_MODEL=
# adc (GOOGLE_APPLICATION_CREDENTIALS key file) | gcloud (local CLI login) | token
VERTEX_AUTH=
# Optional; default {location}-aiplatform.googleapis.com
VERTEX_HOST=
VERTEX_ACCESS_TOKEN=
# Compose only (docker-compose.vertex.yml): path of the service-account key file.
VERTEX_CREDENTIALS_FILE=

# Optional public showcase: explicitly designate only intentionally public farm IDs.
DEMO_MODE=false
DEMO_FARM_IDS=[]
